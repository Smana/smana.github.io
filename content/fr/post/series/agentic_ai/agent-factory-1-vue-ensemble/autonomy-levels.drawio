<mxfile host="drawio"><diagram name="Levels of autonomy" id="autonomy-levels"><mxGraphModel dx="1000" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Levels of autonomy: where the Agent Factory sits" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="900" height="32" as="geometry"/></mxCell><mxCell id="caption" value="After Dan Shapiro's scale, modelled on driving automation." style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="900" height="22" as="geometry"/></mxCell><mxCell id="step0" value="&lt;font style=&quot;font-size:30px&quot;&gt;🌶️&lt;/font&gt;&lt;br&gt;&lt;b&gt;Level 0&lt;/b&gt;&lt;br&gt;&lt;b&gt;Spicy autocomplete&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;you write the code&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=15;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontColor=#1E293B;strokeColor=#64748B;fillColor=#F1F5F9;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="140" height="160" as="geometry"/></mxCell><mxCell id="step1" value="&lt;font style=&quot;font-size:30px&quot;&gt;🧪&lt;/font&gt;&lt;br&gt;&lt;b&gt;Level 1&lt;/b&gt;&lt;br&gt;&lt;b&gt;Discrete tasks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;«&amp;nbsp;write a test&amp;nbsp;»&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;fontFamily=Helvetica;fontSize=15;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontColor=#1E293B;strokeColor=#64748B;fillColor=#E2E8F0;" vert