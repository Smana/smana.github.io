<mxfile host="drawio"><diagram name="The merge gate" id="merge-gate"><mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="The merge gate: merged with no human, or on one approval" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="820" height="32" as="geometry"/></mxCell><mxCell id="caption" value="Four checks run in order on the PR's current commit. Any « no » goes to a maintainer, with a reason code." style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="820" height="22" as="geometry"/></mxCell><mxCell id="pr" value="&lt;b&gt;An agent opens a PR&lt;/b&gt;&lt;br&gt;branch agent/&amp;lt;task&amp;gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;shadow=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#1E293B;align=left;spacingLeft=58;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="320" height="60" as="geometry"/></mxCell><mxCell id="pr-icon" value="🤖" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="100" width="44" height="60" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;① Hygiene&lt;/b&gt;&lt;br&gt;no secret · CI green" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;shadow=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontColor=#1E293B;align=left;spacingLeft=58;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="320" height="64" as="geometry"/></mxCell><mxCell id="s1-icon" value="🧼" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="190" width="44" height="64" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;② Policy&lt;/b&gt;&lt;br&gt;policy-bot green · no gate path" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;shadow=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontColor=#1E293B;align=left;spacingLeft=58;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="320" height="64" as="geometry"/></mxCell><mxCell id="s2-icon" value="📜" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="280" width="44" height="64" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;③ Evidence&lt;/b&gt;&lt;br&gt;the reviewer approved &lt;i&gt;this&lt;/i&gt; commit" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;shadow=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#1E293B;align=left;spacingLeft=58;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="320" height="64" as="geometry"/></mxCell><mxCell id="s3-icon" value="🔍" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="370" width="44" height="64" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;④ Class limits&lt;/b&gt;&lt;br&gt;files · diff size · breaker · daily cap" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;shadow=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#1E293B;align=left;spacingLeft=58;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="320" height="64" as="geometry"/></mxCell><mxCell id="s4-icon" value="📏" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="460" width="44" height="64" as="geometry"/></mxCell><mxCell id="live" value="&lt;font style=&quot;font-size:24px&quot;&gt;🚦&lt;/font&gt;&lt;br&gt;class &lt;b&gt;live&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;shadow=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="110" y="548" width="180" height="100" as="geometry"/></mxCell><mxCell id="human" value="&lt;b&gt;A maintainer reviews&lt;/b&gt;&lt;br&gt;&lt;br&gt;the reason code on the PR&lt;br&gt;says why, and what to do" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;shadow=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#1E293B;align=left;spacingLeft=58;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="190" width="320" height="334" as="geometry"/></mxCell><mxCell id="human-icon" value="🧑‍💻" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="488" y="190" width="44" height="334" as="geometry"/></mxCell><mxCell id="auto" value="&lt;b&gt;Merged with no human&lt;/b&gt;&lt;br&gt;the merger App merges on its own" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2.5;fontFamily=Helvetica;fontSize=14;shadow=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#1E293B;align=left;spacingLeft=58;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="320" height="72" as="geometry"/></mxCell><mxCell id="auto-icon" value="🚀" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="700" width="44" height="72" as="geometry"/></mxCell><mxCell id="watch" value="&lt;b&gt;Watching main for 30 min&lt;/b&gt;&lt;br&gt;a CI check turns red → ↩️ revert" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;shadow=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;align=left;spacingLeft=58;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="320" height="64" as="geometry"/></mxCell><mxCell id="watch-icon" value="👀" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="810" width="44" height="64" as="geometry"/></mxCell><mxCell id="approved" value="&lt;b&gt;Merged on one approval&lt;/b&gt;&lt;br&gt;approving the commit is the merge" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;shadow=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#1E293B;align=left;spacingLeft=58;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="700" width="320" height="72" as="geometry"/></mxCell><mxCell id="approved-icon" value="✅" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="488" y="700" width="44" height="72" as="geometry"/></mxCell><mxCell id="e-pr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#475569;" edge="1" parent="1" source="pr" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-s1s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#475569;" edge="1" parent="1" source="s1" target="s2">