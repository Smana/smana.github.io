<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="drawio" version="30.3.6">
  <diagram name="The merge gate" id="merge-gate">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="The merge gate: what must be true before an agent's PR is merged" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="16" width="1000" height="32" as="geometry" />
        </mxCell>
        <mxCell id="caption" value="Checks run in order, at the PR head. Every « no » becomes a reason code written on the PR, and a decision for a human." style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="20" y="52" width="1100" height="22" as="geometry" />
        </mxCell>

        <mxCell id="pr" value="&lt;b&gt;An agent's PR&lt;/b&gt;&lt;br&gt;branch agent/&amp;lt;task&amp;gt;&lt;br&gt;author: the ogenki-agents App" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="20" y="190" width="180" height="110" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;① Hygiene&lt;/b&gt;&lt;br&gt;&lt;br&gt;secret scan not red&lt;br&gt;required CI checks green&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;red → one bounded fix run&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontColor=#1E293B;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="180" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;② Policy&lt;/b&gt;&lt;br&gt;&lt;br&gt;this repo names this factory&lt;br&gt;policy-bot green, posted by the right login&lt;br&gt;no « gate path » touched&lt;br&gt;author = the agents App" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontColor=#1E293B;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="510" y="180" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;③ Evidence&lt;/b&gt;&lt;br&gt;&lt;br&gt;reviewer verdict « approve »&lt;br&gt;on &lt;i&gt;this&lt;/i&gt; head&lt;br&gt;Agent-Run trailer names a run of the task&lt;br&gt;every push came from the App" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#1E293B;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="770" y="180" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;④ The class&lt;/b&gt;&lt;br&gt;&lt;br&gt;allowed files · diff size&lt;br&gt;shape (links-only, semver-patch)&lt;br&gt;breaker not tripped&lt;br&gt;daily caps not reached" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#1E293B;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1030" y="180" width="210" height="130" as="geometry" />
        </mxCell>

        <mxCell id="live" value="Class&lt;br&gt;&lt;b&gt;live&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1300" y="200" width="150" height="90" as="geometry" />
        </mxCell>

        <mxCell id="merge" value="&lt;b&gt;Merge by the merger App&lt;/b&gt;&lt;br&gt;squash, at the decided head&lt;br&gt;the only App holding the key" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1300" y="380" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="verify" value="&lt;b&gt;Watching main&lt;/b&gt;&lt;br&gt;CI green for 30 min → Done&lt;br&gt;otherwise a revert PR · the breaker counts it" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1300" y="520" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="shadow" value="&lt;b&gt;Shadow class, or plain review&lt;/b&gt;&lt;br&gt;« would auto-merge » comment&lt;br&gt;the decision feeds the class tally&lt;br&gt;a human merges" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1030" y="520" width="210" height="100" as="geometry" />
        </mxCell>

        <mxCell id="human" value="&lt;b&gt;A human decides&lt;/b&gt; · the reason code is written on the PR and exposed as a metric&lt;br&gt;secret_scan_red · ci_red · not_owned · gate_path · policy_pending · verdict_stale · foreign_trailer · human_commit_in_pr · file_not_allowed · patch_too_large · class_paused · auto_merge_cap…" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="250" y="400" width="990" height="90" as="geometry" />
        </mxCell>

