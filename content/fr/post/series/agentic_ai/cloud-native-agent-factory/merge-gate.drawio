<mxfile host="drawio" version="30.3.6">
  <diagram name="Le merge gate" id="merge-gate">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Le merge gate : ce qui doit être vrai avant qu'une PR d'agent soit mergée" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="16" width="1000" height="32" as="geometry" />
        </mxCell>
        <mxCell id="caption" value="Les contrôles s'appliquent dans l'ordre, au head de la PR. Chaque « non » devient un code de raison écrit sur la PR, et une décision pour un humain." style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="20" y="52" width="1100" height="22" as="geometry" />
        </mxCell>

        <mxCell id="pr" value="&lt;b&gt;PR d'un agent&lt;/b&gt;&lt;br&gt;branche agent/&amp;lt;task&amp;gt;&lt;br&gt;auteur : App ogenki-agents" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="20" y="190" width="180" height="110" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;① Hygiène&lt;/b&gt;&lt;br&gt;&lt;br&gt;scan de secrets pas rouge&lt;br&gt;checks CI requis verts&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;rouge → un run de correction borné&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontColor=#1E293B;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="180" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;② Politique&lt;/b&gt;&lt;br&gt;&lt;br&gt;ce dépôt désigne cette factory&lt;br&gt;policy-bot vert, posté par le bon login&lt;br&gt;aucun « gate path » touché&lt;br&gt;auteur = App des agents" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontColor=#1E293B;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="510" y="180" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;③ Preuve&lt;/b&gt;&lt;br&gt;&lt;br&gt;verdict « approve » du reviewer&lt;br&gt;sur &lt;i&gt;ce&lt;/i&gt; head&lt;br&gt;trailer Agent-Run d'un run de la tâche&lt;br&gt;chaque push vient de l'App" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#1E293B;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="770" y="180" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;④ La classe&lt;/b&gt;&lt;br&gt;&lt;br&gt;fichiers autorisés · taille du diff&lt;br&gt;forme (links-only, semver-patch)&lt;br&gt;disjoncteur non sauté&lt;br&gt;plafonds du jour non atteints" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#1E293B;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1030" y="180" width="210" height="130" as="geometry" />
        </mxCell>

        <mxCell id="live" value="Classe&lt;br&gt;&lt;b&gt;live&lt;/b&gt; ?" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1300" y="200" width="150" height="90" as="geometry" />
        </mxCell>

        <mxCell id="merge" value="&lt;b&gt;Merge par l'App merger&lt;/b&gt;&lt;br&gt;squash, au head décidé&lt;br&gt;la seule App qui a la clé" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1300" y="380" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="verify" value="&lt;b&gt;Surveillance de main&lt;/b&gt;&lt;br&gt;CI verte pendant 30 min → Done&lt;br&gt;sinon PR de revert · le disjoncteur compte" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1300" y="520" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="shadow" value="&lt;b&gt;Classe shadow, ou simple revue&lt;/b&gt;&lt;br&gt;commentaire « would auto-merge »&lt;br&gt;la décision nourrit le tally&lt;br&gt;un humain merge" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1030" y="520" width="210" height="100" as="geometry" />
        </mxCell>

        <mxCell id="human" value="&lt;b&gt;Un humain décide&lt;/b&gt; · le code de raison est écrit sur la PR et exposé en métrique&lt;br&gt;secret_scan_red · ci_red · not_owned · gate_path · policy_pending · verdict_stale · foreign_trailer · human_commit_in_pr · file_not_allowed · patch_too_large · class_paused · auto_merge_cap…" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;shadow=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#1E293B;" vertex="1" parent="1">
